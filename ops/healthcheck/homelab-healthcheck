#!/bin/sh
set -eu
umask 077

VERSION=2026-11-18.3
RECOVERY_HELPER=/usr/local/sbin/homelab-healthcheck-recovery
DIAGNOSTICS_HELPER=/usr/local/sbin/homelab-healthcheck-diagnostics
RECOVERY_STATE_DIR=/var/lib/homelab-healthcheck
ACCESS_HELPER=/usr/local/sbin/homelab-healthcheck-access
ACCESS_REBOOT_LIMIT=1
INFRASTRUCTURE_HELPER=/usr/local/sbin/homelab-healthcheck-infrastructure
DNS_REBOOT_LIMIT=1
STORAGE_REBOOT_LIMIT=1
NVME_UUID=""
PIHOLE_PROBE_NAME=pihole.home.arpa
PIHOLE_PROBE_ADDRESS=""
UNBOUND_PROBE_PORT=5335
SSH_CHECK_HOST=127.0.0.1
SSH_CHECK_PORT=22
TAILSCALE_CHECK_INTERFACE=tailscale0
ACCESS_FAILURE_REASON=""
ACCESS_WARNING=""
LOCK_FILE=/run/homelab-healthcheck.lock
CONTAINER_RESTART_DIR=/run/homelab-healthcheck-container-recovery
MAX_FAILURES=3
BOOT_COOLDOWN_SECONDS=600
MAX_REBOOT_COOLDOWN_SECONDS=1800
STABLE_OPERATION_SECONDS=1800
MAX_HEALTHY_GAP_SECONDS=180
CONTAINER_REBOOT_LIMIT=3
CONTAINER_LOG_LINES=200
CONTAINER_LOG_MAX_BYTES=262144
REPORT_MAX_FILES=40
REPORT_MAX_TOTAL_BYTES=10485760
CONTAINER_FAILURE_REASON=""
CONTAINERS_STARTING=""
LOG_TAG=homelab-healthcheck
REPORT_DIR=/var/log/homelab-healthcheck
CRITICAL_CONTAINERS="caddy prometheus node-exporter grafana portainer"
if [ -r /etc/default/homelab-healthcheck ]; then
    # shellcheck source=/dev/null
    . /etc/default/homelab-healthcheck
fi
RUN_STARTED_AT=$(date +%s)

log() {
    logger -t "$LOG_TAG" "$*"
}

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    log "previous run still active, skipping this run"
    exit 0
fi

log "run started version=${VERSION} max_failures=${MAX_FAILURES} boot_cooldown_seconds=${BOOT_COOLDOWN_SECONDS}"

uptime_seconds() {
    awk '{print int($1)}' /proc/uptime
}

write_report() {
    reason=$1
    failures=$2
    timestamp=$(date -u '+%Y%m%dT%H%M%SZ')
    mkdir -p "$REPORT_DIR"
    report=$(mktemp "${REPORT_DIR}/${timestamp}-XXXXXX-reboot-report.log")
    {
        echo "timestamp_utc=${timestamp}"
        echo "script_version=${VERSION}"
        echo "reason=${reason}"
        echo "consecutive_failures=${failures}/${MAX_FAILURES}"
        echo "uptime_seconds=$(uptime_seconds)"
        echo
        echo "== uptime =="
        uptime || true
        echo
        echo "== remote access diagnostics (read-only) =="
        timeout -k 2 50 "$ACCESS_HELPER" --ssh-host "$SSH_CHECK_HOST" --ssh-port "$SSH_CHECK_PORT" --interface "$TAILSCALE_CHECK_INTERFACE" || true
        echo
        echo "== Tailscale network conditions =="
        timeout -k 2 10 tailscale netcheck --format=json || true
        echo
        echo "== systemd failed units =="
        systemctl --failed --no-pager || true
        echo
        echo "== docker ps =="
        timeout 8 docker ps -a || true
        echo
        echo "== docker unhealthy containers =="
        timeout 8 docker ps --filter health=unhealthy || true
        echo
        echo "== mount /mnt/nvme =="
        findmnt /mnt/nvme || true
        echo
        echo "== filesystem options =="
        findmnt -no TARGET,OPTIONS / /mnt/nvme || true
        echo
        echo "== local DNS probe (read-only) =="
        timeout -k 2 30 "$INFRASTRUCTURE_HELPER" dns --name "$PIHOLE_PROBE_NAME" \
            --address "$PIHOLE_PROBE_ADDRESS" --unbound-port "$UNBOUND_PROBE_PORT" || true
        echo
        echo "== disk usage =="
        timeout -k 2 8 df -h || true
        echo
        echo "== memory =="
        free -h || true
        echo
        echo "== NVMe probe (read-only) =="
        timeout -k 2 40 "$INFRASTRUCTURE_HELPER" storage --uuid "$NVME_UUID" || true
        echo
        echo "== recent kernel USB/storage/I/O lines =="
        dmesg -T 2>/dev/null | tail -n 350 | grep -Ei 'I/O error|Buffer I/O error|blk_update_request|EXT4-fs error|reset high-speed USB device|device descriptor read.*error|uas_eh_abort_handler|usb .* reset|sda|mmc|nvme|rtl9210' || true
        echo
        echo "== recent healthcheck journal =="
        journalctl -t "$LOG_TAG" -n 80 --no-pager || true
    } > "$report" 2>&1

    prune_reports
    log "wrote reboot report: ${report}"
}

recovery_decision() {
    "$RECOVERY_HELPER" --state-dir "$RECOVERY_STATE_DIR" \
        --failures "$MAX_FAILURES" \
        --base-cooldown "$BOOT_COOLDOWN_SECONDS" \
        --max-cooldown "$MAX_REBOOT_COOLDOWN_SECONDS" \
        --stable-seconds "$STABLE_OPERATION_SECONDS" \
        --max-healthy-gap "$MAX_HEALTHY_GAP_SECONDS" \
        --container-reboot-limit "$CONTAINER_REBOOT_LIMIT" \
        --access-reboot-limit "$ACCESS_REBOOT_LIMIT" \
        --dns-reboot-limit "$DNS_REBOOT_LIMIT" \
        --storage-reboot-limit "$STORAGE_REBOOT_LIMIT" \
        --kind "${2:-critical}" "$1"
}

prune_reports() {
    "$DIAGNOSTICS_HELPER" --directory "$REPORT_DIR" \
        --max-files "$REPORT_MAX_FILES" --max-total-bytes "$REPORT_MAX_TOTAL_BYTES" \
        || log "could not enforce diagnostic report retention"
}

capture_container_logs() {
    if snapshot=$("$DIAGNOSTICS_HELPER" --directory "$REPORT_DIR" \
        --container "$1" --tail "$CONTAINER_LOG_LINES" --max-bytes "$CONTAINER_LOG_MAX_BYTES" \
        --max-files "$REPORT_MAX_FILES" --max-total-bytes "$REPORT_MAX_TOTAL_BYTES"); then
        log "saved container logs before recovery: container=$1 file=${snapshot}"
    else
        log "could not capture container logs before recovery: container=$1"
    fi
}

fail() {
    reason=$1
    failure_kind=${2:-critical}
    if ! decision=$(recovery_decision failure "$failure_kind"); then
        log "automatic reboot suppressed: recovery state unavailable; ${reason}"
        write_report "recovery state unavailable: ${reason}" unknown || log "could not write failure report"
        exit 1
    fi
    # The helper returns exactly four space-separated, machine-readable fields.
    # This is data, never sourced or evaluated as shell code.
    IFS=' ' read -r action failures cooldown policy_reason extra <<RECOVERY_DECISION
$decision
RECOVERY_DECISION
    if [ -z "$action" ] || [ -z "$policy_reason" ] || [ -n "$extra" ]; then
        log "automatic reboot suppressed: invalid recovery decision"
        exit 1
    fi
    for counter in "$failures" "$cooldown"; do
        case "$counter" in
            ''|*[!0-9]*)
                log "automatic reboot suppressed: invalid recovery counters"
                exit 1
                ;;
        esac
    done
    log "failure ${failures}/${MAX_FAILURES}: kind=${failure_kind} cooldown_seconds=${cooldown} policy=${policy_reason}; ${reason}"

    case "$action" in
        reboot)
            log "requesting host reboot after durable global reservation: ${reason}"
            write_report "$reason" "$failures" || log "could not write reboot report"
            if ! /bin/systemctl reboot; then
                log "reboot request failed; no automatic repeat request in this boot"
            fi
            ;;
        wait)
            log "automatic reboot suppressed: ${policy_reason}; ${reason}"
            # One suppression report at the threshold, not a report every minute.
            if [ "$failures" -eq "$MAX_FAILURES" ]; then
                write_report "${policy_reason}: ${reason}" "$failures" || log "could not write suppression report"
            fi
            ;;
        *) log "automatic reboot suppressed: unexpected recovery action ${action}" ;;
    esac
    exit 1
}

ok() {
    # Only the coordinator calls healthy, once ALL required checks pass.
    if ! decision=$(recovery_decision healthy); then
        log "run completed with recovery state error; stability not recorded"
        exit 1
    fi
    duration=$(( $(date +%s) - RUN_STARTED_AT ))
    log "run completed status=ok duration_seconds=${duration} recovery=${decision}"
}

check_remote_access() {
    ACCESS_FAILURE_REASON=""
    ACCESS_WARNING=""
    access_status=0
    access_result=$(timeout -k 2 160 "$ACCESS_HELPER" "$@" \
        --ssh-host "$SSH_CHECK_HOST" --ssh-port "$SSH_CHECK_PORT" --interface "$TAILSCALE_CHECK_INTERFACE" 2>&1) || access_status=$?
    log "remote access probe: status=${access_status}; ${access_result}"
    case "$access_status" in
        0) return 0 ;;
        10) ACCESS_FAILURE_REASON="confirmed remote access failure: ${access_result}" ;;
        *) ACCESS_WARNING="remote access inconclusive: ${access_result}" ;;
    esac
}

degraded() {
    # Unknown reachability must neither request reboot nor reset episode budgets.
    if ! decision=$(recovery_decision degraded); then
        log "could not persist inconclusive observation; no reboot requested"
        exit 1
    fi
    log "run completed status=degraded recovery=${decision}; $*"
}

run_check() {
    check_kind=$1
    label=$2
    fail_reason=$3
    shift 3
    log "check started: ${label}; command=$*"
    output=$(timeout 8 "$@" 2>&1) || {
        status=$?
        log "check failed: ${label}; exit_status=${status}; output=$(printf '%s' "$output" | tr '\n' ' ' | cut -c1-500)"
        if [ "$check_kind" = containers ]; then
            CONTAINER_FAILURE_REASON="${CONTAINER_FAILURE_REASON}${fail_reason}; "
            return 0
        fi
        fail "$fail_reason"
    }
    log "check passed: ${label}"
}

check_unhealthy_containers() {
    CONTAINER_FAILURE_REASON=""
    CONTAINERS_STARTING=""
    log "check started: docker container health"
    if ! healthy=$(timeout 8 docker ps --filter health=healthy --format '{{.Names}}') ||
       ! starting=$(timeout 8 docker ps --filter health=starting --format '{{.Names}}') ||
       ! unhealthy=$(timeout 8 docker ps --no-trunc --filter health=unhealthy --format '{{.Names}} {{.ID}}'); then
        CONTAINER_FAILURE_REASON="could not list Docker container health; "
        return 1
    fi
    # One restart per unhealthy episode and container ID, until Docker observes
    # it healthy again. /run clears the markers on host reboot.
    if ! mkdir -p "$CONTAINER_RESTART_DIR"; then
        CONTAINER_FAILURE_REASON="could not prepare container recovery markers; "
        return 1
    fi
    healthy=$(printf '%s' "$healthy" | tr '\n' ' ')
    starting=$(printf '%s' "$starting" | tr '\n' ' ')
    for container in $CRITICAL_CONTAINERS; do
        case " $healthy " in
            *" $container "*)
                if ! rm -f -- "$CONTAINER_RESTART_DIR/$container"; then
                    CONTAINER_FAILURE_REASON="${CONTAINER_FAILURE_REASON}${container} recovery marker could not be cleared; "
                fi
                ;;
        esac
        case " $starting " in
            *" $container "*) CONTAINERS_STARTING="${CONTAINERS_STARTING}${container} " ;;
        esac
    done

    while read -r container container_id; do
        [ -n "$container" ] || continue
        case " $CRITICAL_CONTAINERS " in
            *" $container "*) ;;
            *)
                capture_container_logs "$container"
                log "non-critical unhealthy container ignored: ${container}"
                continue
                ;;
        esac
        marker="$CONTAINER_RESTART_DIR/$container"
        if [ -z "$container_id" ]; then
            CONTAINER_FAILURE_REASON="${CONTAINER_FAILURE_REASON}${container} missing Docker ID; "
        elif [ -f "$marker" ] && [ "$(cat "$marker")" = "$container_id" ]; then
            CONTAINER_FAILURE_REASON="${CONTAINER_FAILURE_REASON}${container} still unhealthy after restart attempt; "
        elif printf '%s\n' "$container_id" > "$marker"; then
            capture_container_logs "$container"
            log "critical container unhealthy: ${container}; action=restart"
            if timeout 30 docker restart "$container_id" >/dev/null 2>&1; then
                # Don't poll after a fixed sleep. The next run sees Docker's
                # current status, including any configured startup grace.
                CONTAINERS_STARTING="${CONTAINERS_STARTING}${container} "
            else
                CONTAINER_FAILURE_REASON="${CONTAINER_FAILURE_REASON}${container} restart failed; "
            fi
        else
            CONTAINER_FAILURE_REASON="${CONTAINER_FAILURE_REASON}${container} recovery marker could not be saved; "
        fi
    done <<UNHEALTHY_CONTAINERS
$unhealthy
UNHEALTHY_CONTAINERS
    [ -z "$CONTAINER_FAILURE_REASON" ]
}

check_container_endpoint() {
    endpoint_container=$1
    shift
    case " $CONTAINERS_STARTING " in
        *" $endpoint_container "*)
            log "deferring HTTP probe while container starts: ${endpoint_container}"
            ;;
        *) run_check containers "$@" ;;
    esac
}

check_storage() {
    STORAGE_STATUS=0
    STORAGE_RESULT=$(timeout -k 2 50 "$INFRASTRUCTURE_HELPER" storage \
        --uuid "$NVME_UUID" --monitor \
        --baseline "${RECOVERY_STATE_DIR}/nvme-observation.json" 2>&1) || STORAGE_STATUS=$?
    log "NVMe probe: status=${STORAGE_STATUS}; ${STORAGE_RESULT}"
}

check_dns() {
    DNS_STATUS=0
    DNS_RESULT=$(timeout -k 2 90 "$INFRASTRUCTURE_HELPER" dns \
        --name "$PIHOLE_PROBE_NAME" --address "$PIHOLE_PROBE_ADDRESS" \
        --unbound-port "$UNBOUND_PROBE_PORT" "$@" 2>&1) || DNS_STATUS=$?
    log "DNS probe: status=${DNS_STATUS}; ${DNS_RESULT}"
}

run_checks() {
    check_storage
    # Keep access checks independent of the Docker stack.
    if [ "$STORAGE_STATUS" -ne 0 ]; then
        check_remote_access
        # Preserve DNS visibility, but hold service recovery and all other reboot paths.
        check_dns
        if [ "$STORAGE_STATUS" -eq 10 ]; then
            fail "$STORAGE_RESULT" storage
        fi
        degraded "storage safety hold: $STORAGE_RESULT"
        return
    fi

    check_remote_access --recover
    check_dns --recover
    if [ -n "$ACCESS_FAILURE_REASON" ]; then
        fail "$ACCESS_FAILURE_REASON" access
    fi
    if [ "$DNS_STATUS" -eq 10 ]; then
        fail "$DNS_RESULT" dns
    fi

    run_check critical "docker daemon responsiveness" "docker daemon not responding" docker info
    # Defer container escalation so DNS/storage checks cannot be starved.
    check_unhealthy_containers || log "container recovery pending; continuing critical host checks"
    check_container_endpoint node-exporter "node-exporter metrics endpoint" "node-exporter metrics not responding" curl -fsS --max-time 5 http://127.0.0.1:9100/metrics
    check_container_endpoint grafana "grafana health endpoint" "grafana port not responding" curl -fsS --max-time 5 http://127.0.0.1:3000/api/health
    check_container_endpoint prometheus "prometheus health endpoint" "prometheus health not responding" curl -fsS --max-time 5 http://127.0.0.1:9090/-/healthy
    if [ -n "$CONTAINER_FAILURE_REASON" ]; then
        fail "$CONTAINER_FAILURE_REASON" containers
    fi
    if [ -n "$ACCESS_WARNING" ]; then
        degraded "$ACCESS_WARNING"
        return
    fi
    if [ "$DNS_STATUS" -ne 0 ]; then
        degraded "$DNS_RESULT"
        return
    fi
    if [ -n "$CONTAINERS_STARTING" ]; then
        degraded "waiting for Docker startup: ${CONTAINERS_STARTING}"
        return
    fi
    ok
}

run_checks
