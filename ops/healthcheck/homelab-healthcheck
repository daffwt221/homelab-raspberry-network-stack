#!/bin/sh
set -eu

VERSION=2026-10-02.3
STATE_FILE=/run/homelab-healthcheck.failures
UNSAFE_SHUTDOWNS_STATE_FILE=/run/homelab-healthcheck.nvme_unsafe_shutdowns
LOCK_FILE=/run/homelab-healthcheck.lock
MAX_FAILURES=3
BOOT_COOLDOWN_SECONDS=600
LOG_TAG=homelab-healthcheck
REPORT_DIR=/var/log/homelab-healthcheck
CRITICAL_CONTAINERS="caddy prometheus node-exporter grafana portainer"
DNS_CHECK_HOST=google.com
PIHOLE_DNS_HOST=pihole.home.arpa
PIHOLE_TEST_DOMAINS="google.com github.com cloudflare.com"
PIHOLE_RESTART_ATTEMPTS=2
RUN_STARTED_AT=$(date +%s)

log() {
    logger -t "$LOG_TAG" "$*"
}

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    log "previous run still active, skipping this run"
    exit 0
fi

log "run started version=${VERSION} max_failures=${MAX_FAILURES} boot_cooldown_seconds=${BOOT_COOLDOWN_SECONDS}"

uptime_seconds() {
    awk '{print int($1)}' /proc/uptime
}

get_nvme_unsafe_shutdowns() {
    timeout 10 smartctl -a -T permissive /dev/sda 2>/dev/null |
        awk -F: '/^Unsafe Shutdowns:/ {gsub(/,| /,"",$2); print $2; exit}'
}

write_report() {
    reason=$1
    failures=$2
    timestamp=$(date -u '+%Y%m%dT%H%M%SZ')
    report="${REPORT_DIR}/${timestamp}-reboot-report.log"

    mkdir -p "$REPORT_DIR"
    {
        echo "timestamp_utc=${timestamp}"
        echo "script_version=${VERSION}"
        echo "reason=${reason}"
        echo "consecutive_failures=${failures}/${MAX_FAILURES}"
        echo "uptime_seconds=$(uptime_seconds)"
        echo
        echo "== uptime =="
        uptime || true
        echo
        echo "== systemd failed units =="
        systemctl --failed --no-pager || true
        echo
        echo "== docker ps =="
        timeout 8 docker ps -a || true
        echo
        echo "== docker unhealthy containers =="
        timeout 8 docker ps --filter health=unhealthy || true
        echo
        echo "== mount /mnt/nvme =="
        findmnt /mnt/nvme || true
        echo
        echo "== filesystem options =="
        findmnt -no TARGET,OPTIONS / /mnt/nvme || true
        echo
        echo "== dns check =="
        timeout 8 getent hosts "$DNS_CHECK_HOST" || true
        echo
        echo "== pihole dns check =="
        timeout 8 getent hosts "$PIHOLE_DNS_HOST" || true
        for domain in $PIHOLE_TEST_DOMAINS; do
            if command -v dig >/dev/null 2>&1; then
                timeout 8 dig +time=3 +tries=1 +short @"$PIHOLE_DNS_HOST" "$domain" || true
            elif command -v nslookup >/dev/null 2>&1; then
                timeout 8 nslookup "$domain" "$PIHOLE_DNS_HOST" || true
            else
                echo "dig/nslookup unavailable"
            fi
        done
        echo
        echo "== disk usage =="
        df -h || true
        echo
        echo "== memory =="
        free -h || true
        echo
        echo "== nvme smart summary =="
        timeout 10 smartctl -a -T permissive /dev/sda 2>&1 | grep -E 'Temperature|Percentage Used|Power Cycles|Unsafe Shutdowns|Media and Data|Error Information' || true
        echo
        echo "== recent kernel USB/storage/I/O lines =="
        dmesg -T 2>/dev/null | tail -n 350 | grep -Ei 'I/O error|Buffer I/O error|blk_update_request|EXT4-fs error|reset high-speed USB device|device descriptor read.*error|uas_eh_abort_handler|usb .* reset|sda|mmc|nvme|rtl9210' || true
        echo
        echo "== recent healthcheck journal =="
        journalctl -t "$LOG_TAG" -n 80 --no-pager || true
    } > "$report" 2>&1

    log "wrote reboot report: ${report}"
}

fail() {
    reason=$1
    failures=0
    if [ -r "$STATE_FILE" ]; then
        failures=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
    fi
    failures=$((failures + 1))
    printf '%s\n' "$failures" > "$STATE_FILE"
    log "failure ${failures}/${MAX_FAILURES}: ${reason}"

    if [ "$failures" -ge "$MAX_FAILURES" ]; then
        if [ "$(uptime_seconds)" -lt "$BOOT_COOLDOWN_SECONDS" ]; then
            log "reboot suppressed during ${BOOT_COOLDOWN_SECONDS}s boot cooldown: ${reason}"
            write_report "boot cooldown suppressed reboot: ${reason}" "$failures"
            exit 1
        fi
        log "rebooting after ${failures} consecutive failures: ${reason}"
        write_report "$reason" "$failures"
        /bin/systemctl reboot
    fi

    exit 1
}

ok() {
    if [ -e "$STATE_FILE" ]; then
        rm -f "$STATE_FILE"
    fi
    duration=$(( $(date +%s) - RUN_STARTED_AT ))
    log "run completed status=ok duration_seconds=${duration}"
}

run_check() {
    label=$1
    fail_reason=$2
    shift
    shift
    log "check started: ${label}; command=$*"
    output=$(timeout 8 "$@" 2>&1) || {
        status=$?
        log "check failed: ${label}; exit_status=${status}; output=$(printf '%s' "$output" | tr '\n' ' ' | cut -c1-500)"
        fail "$fail_reason"
    }
    log "check passed: ${label}"
}

check_unhealthy_containers() {
    log "check started: docker unhealthy containers"
    unhealthy=$(timeout 8 docker ps --filter health=unhealthy --format '{{.Names}}' 2>/dev/null || true)
    if [ -z "$unhealthy" ]; then
        log "check passed: no unhealthy containers"
        return 0
    fi

    log "unhealthy containers detected: $(printf '%s' "$unhealthy" | tr '\n' ' ')"

    for container in $unhealthy; do
        for critical in $CRITICAL_CONTAINERS; do
            if [ "$container" = "$critical" ]; then
                log "critical container unhealthy: ${container}; action=restart"
                timeout 30 docker restart "$container" >/dev/null 2>&1 || fail "critical container restart failed: ${container}"
                sleep 20

                state=$(timeout 8 docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container" 2>/dev/null || echo unknown)
                if [ "$state" = "healthy" ] || [ "$state" = "none" ]; then
                    log "critical container recovered after restart: ${container} health=${state}"
                    return 0
                fi

                fail "critical container still unhealthy after restart: ${container} health=${state}"
            fi
        done
    done

    log "non-critical unhealthy containers ignored: $(printf '%s' "$unhealthy" | tr '\n' ' ')"
}

check_filesystem_rw() {
    log "check started: filesystem read-write state"
    for mountpoint in / /mnt/nvme; do
        options=$(findmnt -no OPTIONS "$mountpoint" 2>/dev/null || true)
        [ -n "$options" ] || fail "${mountpoint} mount options unavailable"
        log "mount options: ${mountpoint} ${options}"
        case ",${options}," in
            *,ro,*) fail "${mountpoint} is mounted read-only" ;;
        esac
    done
    log "check passed: filesystem read-write state"
}

check_nvme_unsafe_shutdowns() {
    log "check started: NVMe unsafe shutdown counter"
    current=$(get_nvme_unsafe_shutdowns || true)
    [ -n "$current" ] || fail "NVMe unsafe shutdown counter unavailable"

    if [ -r "$UNSAFE_SHUTDOWNS_STATE_FILE" ]; then
        previous=$(cat "$UNSAFE_SHUTDOWNS_STATE_FILE" 2>/dev/null || echo "$current")
        log "NVMe unsafe shutdown counter previous=${previous} current=${current}"
        if [ "$current" -gt "$previous" ]; then
            printf '%s\n' "$current" > "$UNSAFE_SHUTDOWNS_STATE_FILE"
            fail "NVMe unsafe shutdown counter increased from ${previous} to ${current}"
        fi
    else
        log "NVMe unsafe shutdown baseline initialized current=${current}"
    fi

    printf '%s\n' "$current" > "$UNSAFE_SHUTDOWNS_STATE_FILE"
    log "check passed: NVMe unsafe shutdown counter"
}

resolve_via_pihole() {
    domain=$1

    if command -v dig >/dev/null 2>&1; then
        timeout 8 dig +time=3 +tries=1 +short @"$PIHOLE_DNS_HOST" "$domain" |
            grep -Eq '^[0-9a-fA-F:.]+$'
        return $?
    fi

    if command -v nslookup >/dev/null 2>&1; then
        timeout 8 nslookup "$domain" "$PIHOLE_DNS_HOST" |
            grep -Eq '^Address: |^Name: '
        return $?
    fi

    log "pihole DNS check unavailable: neither dig nor nslookup exists"
    return 1
}

restart_pihole() {
    if timeout 8 docker inspect pihole >/dev/null 2>&1; then
        log "pihole recovery action: docker restart pihole"
        timeout 45 docker restart pihole >/dev/null 2>&1
        return $?
    fi

    if systemctl list-unit-files pihole-FTL.service --no-legend 2>/dev/null | grep -q '^pihole-FTL\.service'; then
        log "pihole recovery action: systemctl restart pihole-FTL.service"
        timeout 45 systemctl restart pihole-FTL.service
        return $?
    fi

    log "pihole recovery unavailable: no docker container named pihole and no pihole-FTL.service"
    return 1
}

check_pihole_dns() {
    log "check started: Pi-hole DNS resolver host=${PIHOLE_DNS_HOST} domains=$(printf '%s' "$PIHOLE_TEST_DOMAINS" | tr ' ' ',') restart_attempts=${PIHOLE_RESTART_ATTEMPTS}"

    run=0
    while [ "$run" -le "$PIHOLE_RESTART_ATTEMPTS" ]; do
        failed_domains=""
        for domain in $PIHOLE_TEST_DOMAINS; do
            if resolve_via_pihole "$domain"; then
                log "pihole resolved domain=${domain} via=${PIHOLE_DNS_HOST}"
            else
                failed_domains="${failed_domains} ${domain}"
                log "pihole failed to resolve domain=${domain} via=${PIHOLE_DNS_HOST}"
            fi
        done

        if [ -z "$failed_domains" ]; then
            log "check passed: Pi-hole DNS resolver"
            return 0
        fi

        if [ "$run" -ge "$PIHOLE_RESTART_ATTEMPTS" ]; then
            fail "Pi-hole DNS still failing after ${PIHOLE_RESTART_ATTEMPTS} restart attempts; failed_domains=$(printf '%s' "$failed_domains" | sed 's/^ //')"
        fi

        run=$((run + 1))
        log "Pi-hole DNS failed; attempting recovery ${run}/${PIHOLE_RESTART_ATTEMPTS}; failed_domains=$(printf '%s' "$failed_domains" | sed 's/^ //')"
        restart_pihole || log "Pi-hole restart attempt ${run}/${PIHOLE_RESTART_ATTEMPTS} failed"
        sleep 15
    done
}

run_check "docker daemon responsiveness" "docker daemon not responding" docker info
check_unhealthy_containers
run_check "node-exporter metrics endpoint" "node-exporter metrics not responding" curl -fsS --max-time 5 http://127.0.0.1:9100/metrics
run_check "grafana health endpoint" "grafana port not responding" curl -fsS --max-time 5 http://127.0.0.1:3000/api/health
run_check "prometheus health endpoint" "prometheus health not responding" curl -fsS --max-time 5 http://127.0.0.1:9090/-/healthy
run_check "/mnt/nvme mountpoint" "/mnt/nvme is not mounted" mountpoint -q /mnt/nvme
check_filesystem_rw
check_nvme_unsafe_shutdowns
run_check "DNS resolution for ${DNS_CHECK_HOST}" "DNS resolution failed for ${DNS_CHECK_HOST}" getent hosts "$DNS_CHECK_HOST"
check_pihole_dns

if dmesg -T 2>/dev/null | tail -n 250 | grep -Eiq 'I/O error|Buffer I/O error|blk_update_request|EXT4-fs error|reset high-speed USB device|device descriptor read.*error|uas_eh_abort_handler|usb .* reset'; then
    fail "recent kernel log contains USB/storage/I/O errors"
fi
log "check passed: recent kernel log contains no USB/storage/I/O errors"

ok
